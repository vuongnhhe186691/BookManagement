<Window x:Class="A_PRN212.Author_lib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Authors Management - Librarian" Height="660" Width="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Authors Management" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Maintain author records and biographies" Style="{StaticResource PageSubtitleStyle}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnReturn" Content="← Back to Home"
                        Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Click="btnReturn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="0">
                <DataGrid x:Name="dataGridAuthor"
                          ItemsSource="{Binding Authors}"
                          SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding AuthorId}" Width="55"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding AuthorName}" Width="160"/>
                        <DataGridTextColumn Header="Biography" Binding="{Binding Biography}" Width="*"/>
                        <DataGridTextColumn Header="Nationality" Binding="{Binding Nationality}" Width="120"/>
                        <DataGridTextColumn Header="BirthDate" Binding="{Binding BirthDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Author Details" Style="{StaticResource SectionTitleStyle}"/>

                        <Label Content="Author ID"/>
                        <TextBox x:Name="txtId" Text="{Binding AuthorIdText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Author Name"/>
                        <TextBox x:Name="txtName" Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Biography"/>
                        <TextBox x:Name="txtBiography" Text="{Binding Biography, UpdateSourceTrigger=PropertyChanged}"
                                 Height="74" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8"/>

                        <Label Content="Nationality"/>
                        <TextBox x:Name="txtNationality" Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Birth Date"/>
                        <DatePicker x:Name="txtBirthDate" SelectedDate="{Binding BirthDate, Mode=TwoWay}" Margin="0,0,0,16"/>

                        <UniformGrid Columns="3" Margin="0,0,0,10">
                            <Button x:Name="btnInsert" Content="Insert" Style="{StaticResource SuccessButtonStyle}" Command="{Binding InsertCommand}" Margin="0,0,6,0"/>
                            <Button x:Name="btnUpdate" Content="Update" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding UpdateCommand}" Margin="3,0"/>
                            <Button x:Name="btnDelete" Content="Delete" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteCommand}" Margin="6,0,0,0"/>
                        </UniformGrid>

                        <UniformGrid Columns="2">
                            <Button x:Name="btnSearch" Content="Search" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="0,0,6,0"/>
                            <Button x:Name="btnClear" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" Margin="6,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
