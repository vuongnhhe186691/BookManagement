<Window x:Class="A_PRN212.BorrowRecord_admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Borrow Records - Admin" Height="640" Width="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Borrow Records Overview" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Monitor all active loans, returns, and calculated fines" Style="{StaticResource PageSubtitleStyle}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnReturn" Content="← Back to Home"
                        Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Click="btnReturn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="0">
                <DataGrid x:Name="dataGridBorrowRecords"
                          ItemsSource="{Binding BorrowRecords}"
                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Borrow ID" Binding="{Binding BorrowId}" Width="80"/>
                        <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="75"/>
                        <DataGridTextColumn Header="Book ID" Binding="{Binding BookId}" Width="75"/>
                        <DataGridTextColumn Header="Borrow Date" Binding="{Binding BorrowDate, StringFormat={}{0:yyyy-MM-dd}}" Width="115"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="115"/>
                        <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="115"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/>
                        <DataGridTextColumn Header="Fine" Binding="{Binding FineAmount, StringFormat={}{0:N0} VND}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="1">
                <StackPanel>
                    <TextBlock Text="Actions" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="Select a borrow record from the table to mark it as returned."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button x:Name="btnDone" Content="Mark as Returned"
                            Style="{StaticResource SuccessButtonStyle}"
                            Height="40" Command="{Binding MarkReturnedCommand}" Margin="0,0,0,10"/>
                    <Button x:Name="btnRefresh" Content="Refresh List"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
