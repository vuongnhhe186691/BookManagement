<Window x:Class="A_PRN212.BorrowRecord_user"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Borrow Confirmation" Height="520" Width="760"
        Background="{StaticResource AuthBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource DialogCardBorderStyle}"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="#ECFDF5"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="✅" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Book Borrowed Successfully!" FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Please return the book on or before the due date"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,22"/>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Borrow Date" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtBorrowDate" Text="{Binding LatestBorrowDateText}" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Due Date" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDueDate" Text="{Binding LatestDueDateText}" FontWeight="Bold" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Status" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtStatus" Text="{Binding LatestStatusText}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <Button x:Name="btnReturn" Content="Back to Home"
                        Height="40" Click="btnReturn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
