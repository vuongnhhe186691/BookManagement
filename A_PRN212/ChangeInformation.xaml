<Window x:Class="A_PRN212.ChangeInformation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Edit Profile Information" Height="680" Width="880">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update Profile" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Keep your personal contact details up to date" Style="{StaticResource PageSubtitleStyle}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnReturn" Content="← Back to Profile"
                        Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="140" Click="btnReturn_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <TextBlock Text="Personal Information" Style="{StaticResource SectionTitleStyle}"/>

                <Label Content="Full Name"/>
                <TextBox x:Name="txtFullName" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Gender"/>
                        <ComboBox x:Name="cmbGender"
                                  SelectedValue="{Binding Gender, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Phone"/>
                        <TextBox x:Name="txtPhone" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Username"/>
                <TextBox x:Name="txtUsername" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Email"/>
                <TextBox x:Name="txtEmail" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Password"/>
                <PasswordBox x:Name="txtPassword" PasswordChanged="txtPassword_PasswordChanged"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,18">
                    <TextBlock Text="Account Role: " Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRole" Text="{Binding Role}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"/>
                </StackPanel>

                <Button x:Name="btnChange" Content="Save Changes"
                        Style="{StaticResource SuccessButtonStyle}"
                        Height="40" Command="{Binding SaveProfileCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
