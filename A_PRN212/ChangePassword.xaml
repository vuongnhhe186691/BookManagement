<Window x:Class="A_PRN212.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Change Password"
        Height="540" Width="860"
        Background="{StaticResource AuthBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource DialogCardBorderStyle}"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <TextBlock Text="Set New Password" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Choose a strong password for your account"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,18"/>

                <Label Content="New Password"/>
                <PasswordBox x:Name="txtPassword"
                             PasswordChanged="txtPassword_PasswordChanged"
                             Margin="0,0,0,10"/>

                <Label Content="Confirm Password"/>
                <PasswordBox x:Name="txtConfirm"
                             PasswordChanged="txtConfirm_PasswordChanged"
                             Margin="0,0,0,18"/>

                <Button x:Name="btnChange" Content="Update Password"
                        Height="40" Command="{Binding ChangePasswordCommand}" Margin="0,0,0,10"/>

                <Button x:Name="btnCancel" Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
