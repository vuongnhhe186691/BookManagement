<Window x:Class="A_PRN212.ForgotPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Forgot Password"
        Height="560" Width="860"
        Background="{StaticResource AuthBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource DialogCardBorderStyle}"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <Border Width="50" Height="50" CornerRadius="14"
                        Background="{StaticResource PrimarySoftBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="🔐" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Reset Password" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Enter your registered email to receive an OTP code"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,4,0,18"/>

                <Label Content="Email Address"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtEmail" Grid.Column="0"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button x:Name="btnSendOTP" Grid.Column="2" Content="Send OTP"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SendOtpCommand}" Width="100"/>
                </Grid>

                <Label Content="OTP Code"/>
                <TextBox x:Name="txtOTP"
                         Text="{Binding OtpCode, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,18"/>

                <Button x:Name="btnVerify" Content="Verify OTP"
                        Height="40" Command="{Binding VerifyOtpCommand}" Margin="0,0,0,10"/>

                <Button x:Name="btnCancel" Content="Back to Sign In"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
