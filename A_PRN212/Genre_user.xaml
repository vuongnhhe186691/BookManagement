<Window x:Class="A_PRN212.Genre_user"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Book Genres" Height="640" Width="1060">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Book Genres" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Browse and search library categories" Style="{StaticResource PageSubtitleStyle}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnReturn" Content="← Back to Home"
                        Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Click="btnReturn_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="0">
                <DataGrid x:Name="dataGridGenres"
                          ItemsSource="{Binding Genres}"
                          SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding GenreId}" Width="60"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}"
                    mvvm:UiAnimation.Entrance="Surface" mvvm:UiAnimation.StaggerIndex="1">
                <StackPanel>
                    <TextBlock Text="Genre Filter &amp; Info" Style="{StaticResource SectionTitleStyle}"/>

                    <Label Content="Genre ID"/>
                    <TextBox x:Name="txtId" Text="{Binding GenreIdText, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Genre Name"/>
                    <TextBox x:Name="txtName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="Description"/>
                    <TextBox x:Name="txtDescription" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             Height="96" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Button x:Name="btnSearch" Content="Search" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="0,0,6,0"/>
                        <Button x:Name="btnClear" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearCommand}" Margin="6,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
