<Window x:Class="A_PRN212.PasswordCheck"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Verify Identity"
        Height="520" Width="820"
        Background="{StaticResource AuthBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource DialogCardBorderStyle}"
                Width="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <Border Width="50" Height="50" CornerRadius="14"
                        Background="{StaticResource PrimarySoftBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="🛡️" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Security Verification" FontSize="21" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Enter your current password to edit profile information"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,4,0,18"/>

                <Label Content="Current Password"/>
                <PasswordBox x:Name="txtPassword"
                             PasswordChanged="txtPassword_PasswordChanged"
                             Margin="0,0,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancel" Grid.Column="0" Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Click="btnCancel_Click"/>
                    <Button x:Name="btnCheck" Grid.Column="2" Content="Verify"
                            Height="38" Command="{Binding CheckPasswordCommand}"/>
                </Grid>

                <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Forgot password? " />
                    <Hyperlink Click="Change_Click" Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="Reset via OTP" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
