<Window x:Class="A_PRN212.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="Library Management - Create Account"
        Height="680" Width="920"
        Background="{StaticResource AuthBackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource DialogCardBorderStyle}"
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <TextBlock Text="Create Account" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Register as a library reader"
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,16"/>

                <Label Content="Full Name"/>
                <TextBox Name="txtFullName"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Gender"/>
                        <ComboBox Name="cbGender"
                                  SelectedValue="{Binding Gender, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Phone"/>
                        <TextBox Name="txtPhone"
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Username"/>
                <TextBox Name="txtUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>

                <Label Content="Email"/>
                <TextBox Name="txtEmail"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>

                <Label Content="Password"/>
                <PasswordBox Name="txtPassword"
                             PasswordChanged="txtPassword_PasswordChanged"
                             Margin="0,0,0,16"/>

                <Button Name="btnSignUp" Content="Create Account"
                        Height="40" FontSize="14"
                        Command="{Binding SignUpCommand}"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Already have an account? " />
                    <Hyperlink Command="{Binding NavigateLoginCommand}" Foreground="{StaticResource PrimaryBrush}">
                        <Run Text="Sign in" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
