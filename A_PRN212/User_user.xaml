<Window x:Class="A_PRN212.User_user"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:A_PRN212"
        xmlns:mvvm="clr-namespace:A_PRN212.MVVM"
        mc:Ignorable="d"
        Title="My Profile" Height="620" Width="880">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="28,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Reader Profile" Style="{StaticResource PageTitleStyle}" FontSize="20"/>
                    <TextBlock Text="Review your account details and security settings" Style="{StaticResource PageSubtitleStyle}" FontSize="12"/>
                </StackPanel>
                <Button x:Name="btnReturn" Content="← Back to Home"
                        Style="{StaticResource HeaderButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="130" Click="btnReturn_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}"
                Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                mvvm:UiAnimation.Entrance="Dialog">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0">
                        <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtFullName" Text="{Binding FullName}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="txtRole" Text="{Binding Role}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gender" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtGender" Text="{Binding Gender}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Username" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtUsername" Text="{Binding Username}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Email" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtEmail" Text="{Binding Email}" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Phone" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="txtPhone" Text="{Binding Phone}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <Button x:Name="btnChange" Content="Edit Profile Information"
                        Height="40" Click="btnChange_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
